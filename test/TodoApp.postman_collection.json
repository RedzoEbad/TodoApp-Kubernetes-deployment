    {
      "name": "POST todo",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Check if response exists and has valid JSON\r",
              "if (pm.response.code === 201 && pm.response.json()) {\r",
              "  let res = pm.response.json();\r",
              "  \r",
              "  // extract todo id\r",
              "  let todoId = res.todo._id;\r",
              "  \r",
              "  // save it globally for next request\r",
              "  pm.environment.set(\"todoId\", todoId);\r",
              "  \r",
              "  console.log(\"Saved Todo ID:\", todoId);\r",
              "} else {\r",
              "  console.log(\"POST request failed or invalid response\");\r",
              "  console.log(\"Response code:\", pm.response.code);\r",
              "  console.log(\"Response body:\", pm.response.text());\r",
              "}"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"text\": \"New todo item\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
